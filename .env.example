# Telegram Bot Tokens
ADMIN_BOT_TOKEN=your_admin_bot_token_here
PLAYER_BOT_TOKEN=your_player_bot_token_here

# Database Configuration
DATABASE_URL=postgresql://gameuser:gamepass@localhost:5432/gamedb
POSTGRES_DB=gamedb
POSTGRES_USER=gameuser
POSTGRES_PASSWORD=gamepass

# Redis Configuration
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# File Storage
MEDIA_STORAGE_PATH=/app/media
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Game Configuration
MAX_PLAYERS_PER_SESSION=50
SESSION_TIMEOUT_MINUTES=60
QUESTION_TIMEOUT_SECONDS=30

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# External Services
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Development
ENVIRONMENT=development